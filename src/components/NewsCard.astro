---
import { catOf, turLabel, fmtShort, haberUrl, img, readMins, type Haber } from '../lib/news';
import { langOf, T } from '../lib/i18n';

interface Props {
  item: Haber;
  variant?: 'card' | 'lead' | 'row' | 'row-big';
  excerpt?: boolean;
}
const { item, variant = 'card', excerpt = true } = Astro.props;
const lang = langOf(Astro.url);
const t = T[lang];
const d = item.data;
const c = catOf(d.category, lang);
const isRow = variant === 'row' || variant === 'row-big';
---

<a
  class:list={[isRow ? 'story-row' : 'story', { 'story--lead': variant === 'lead', 'story-row--big': variant === 'row-big' }]}
  href={haberUrl(item.id, lang)}
  style={`--c:${c.color}`}
>
  <div class="story-img">
    <img src={img(d.image, 640)} alt={d.imageAlt ?? d.title} width="640" height="400" loading="lazy" decoding="async" />
  </div>
  <div class="story-body">
    <span class="cat">{c.name}{d.tur && d.tur !== 'haber' && <em class="tur">{turLabel(d.tur, lang)}</em>}</span>
    <h3>{d.title}</h3>
    {excerpt && variant !== 'row' && <p>{d.description}</p>}
    <div class="meta">
      <time datetime={d.date.toISOString()} data-rel>{fmtShort(d.date, lang)}</time>
      <span class="rt">{readMins(item.body)} {t.readMin}</span>
    </div>
  </div>
</a>
