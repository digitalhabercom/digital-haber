---
import { catOf, fmtShort, haberUrl, readMins, type Haber } from '../lib/news';

interface Props {
  item: Haber;
  variant?: 'card' | 'lead' | 'row' | 'row-big';
  excerpt?: boolean;
}
const { item, variant = 'card', excerpt = true } = Astro.props;
const d = item.data;
const c = catOf(d.category);
const isRow = variant === 'row' || variant === 'row-big';
---

<a
  class:list={[isRow ? 'story-row' : 'story', { 'story--lead': variant === 'lead', 'story-row--big': variant === 'row-big' }]}
  href={haberUrl(item.id)}
  style={`--c:${c.color}`}
>
  <div class="story-img">
    <img src={d.image} alt={d.imageAlt ?? d.title} width="640" height="400" loading="lazy" decoding="async" />
  </div>
  <div class="story-body">
    <span class="cat">{c.name}</span>
    <h3>{d.title}</h3>
    {excerpt && variant !== 'row' && <p>{d.description}</p>}
    <div class="meta">
      <time datetime={d.date.toISOString()}>{fmtShort(d.date)}</time>
      <span>{readMins(item.body)} dk okuma</span>
    </div>
  </div>
</a>
