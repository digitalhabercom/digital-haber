---
interface Props {
  url: string;
  title: string;
  image?: string;
}
const { url, title, image = '' } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const m = encodeURIComponent(image);

const targets = [
  { name: 'Pinterest', cls: 'c-pin', ico: 'P', href: `https://pinterest.com/pin/create/button/?url=${u}&media=${m}&description=${t}` },
  { name: 'Facebook', cls: 'c-fb', ico: 'f', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'X (Twitter)', cls: 'c-x', ico: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
  { name: 'WhatsApp', cls: 'c-wa', ico: 'W', href: `https://wa.me/?text=${t}%20${u}` },
  { name: 'Telegram', cls: 'c-tg', ico: 'T', href: `https://t.me/share/url?url=${u}&text=${t}` },
  { name: 'Messenger', cls: 'c-ms', ico: 'M', href: `fb-messenger://share/?link=${u}` },
  { name: 'Reddit', cls: 'c-rd', ico: 'R', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { name: 'LinkedIn', cls: 'c-in', ico: 'in', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
];
const mail = `mailto:?subject=${t}&body=${u}`;
---

<dialog class="share" id="share-dialog" aria-labelledby="share-title">
  <div class="share-in">
    <div class="share-head">
      <h2 id="share-title">Bu haberi paylaş</h2>
      <p>{title}</p>
      <button class="share-close" type="button" data-share-close aria-label="Kapat">✕</button>
    </div>

    <div class="share-grid">
      {
        targets.map((s) => (
          <a class={`share-btn ${s.cls}`} href={s.href} target="_blank" rel="noopener noreferrer">
            <i>{s.ico}</i>
            {s.name}
          </a>
        ))
      }
      <a class="share-btn wide c-mail" href={mail}>
        <i>@</i> E-Posta
      </a>
    </div>

    <div class="share-or">veya bağlantıyı kopyala</div>
    <div class="share-copy">
      <input type="text" readonly value={url} id="share-url" aria-label="Haber bağlantısı" />
      <button type="button" id="share-copy">Kopyala</button>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('share-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('share-url') as HTMLInputElement | null;
  const copyBtn = document.getElementById('share-copy') as HTMLButtonElement | null;

  document.querySelectorAll('[data-share-open]').forEach((b) =>
    b.addEventListener('click', () => dlg?.showModal())
  );
  dlg?.querySelector('[data-share-close]')?.addEventListener('click', () => dlg.close());
  // Pencerenin dışına tıklayınca kapat
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  copyBtn?.addEventListener('click', async () => {
    if (!input) return;
    try {
      await navigator.clipboard.writeText(input.value);
    } catch {
      input.select();
      document.execCommand('copy');
    }
    const old = copyBtn.textContent;
    copyBtn.textContent = 'Kopyalandı ✓';
    setTimeout(() => (copyBtn.textContent = old), 1800);
  });
</script>
