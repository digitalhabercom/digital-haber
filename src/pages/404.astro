---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı" noindex={true}>
  <div class="page-head">
    <h1>Sayfa bulunamadı</h1>
    <p>Aradığınız sayfa taşınmış ya da kaldırılmış olabilir. Ana sayfaya dönebilir veya haberlerde arama yapabilirsiniz.</p>
  </div>
  <p style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px">
    <a class="btn" href="/">Ana sayfaya dön</a>
    <a class="btn btn--ghost" href="/arama/">Haberlerde ara</a>
  </p>
</Base>
