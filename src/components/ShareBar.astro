---
import Icon from './Icon.astro';
import { shareHref } from '../lib/share';

interface Props {
  url: string;
  title: string;
  image?: string;
}
const { url, title, image = '' } = Astro.props;
const ctx = { url, title, image };
---

<div class="sharebar" role="group" aria-label="Haberi paylaş">
  <button class="sb sb--main" type="button" data-share-open data-url={url} data-title={title} data-image={image}>
    <Icon name="share" size={16} /> Paylaş
  </button>
  <a class="sb" style="--bc:#1fa855" href={shareHref('whatsapp', ctx)} target="_blank" rel="noopener noreferrer">
    <Icon name="whatsapp" size={16} /> WhatsApp
  </a>
  <a class="sb sb--hide" style="--bc:#111111" href={shareHref('x', ctx)} target="_blank" rel="noopener noreferrer">
    <Icon name="x" size={16} /> X
  </a>
  <a class="sb sb--hide" style="--bc:#1877f2" href={shareHref('facebook', ctx)} target="_blank" rel="noopener noreferrer">
    <Icon name="facebook" size={16} /> Facebook
  </a>
  <a class="sb sb--hide" style="--bc:#229ed9" href={shareHref('telegram', ctx)} target="_blank" rel="noopener noreferrer">
    <Icon name="telegram" size={16} /> Telegram
  </a>
  <button class="sb sb--plain" type="button" data-copy-link data-url={url}>
    <Icon name="link" size={16} /> Bağlantıyı kopyala
  </button>
</div>
