---
import NewsCard from './NewsCard.astro';
import type { Haber } from '../lib/news';
import { langOf, T, ROUTES } from '../lib/i18n';

interface Props {
  items: Haber[];
  excludeIds?: string[];
  count?: number;
}
const { items, excludeIds = [], count = 8 } = Astro.props;
const lang = langOf(Astro.url);
const t = T[lang];
const r = ROUTES[lang];
---

<section class="sec" aria-labelledby="rastgele">
  <div class="sec-head">
    <h2 id="rastgele">{t.picks}</h2>
    <a href={r.all}>{t.allNewsLower}</a>
  </div>
  <div class="grid4" id="picks" data-count={count} data-exclude={JSON.stringify(excludeIds)} data-json={r.searchJson} data-rm={t.readMin}>
    {items.map((h) => <NewsCard item={h} excerpt={false} />)}
  </div>
</section>

<script>
  // Her sayfa yenilemesinde farklı haberler gösterir. Sayfa HTML'inde hazır gelen liste, tarayıcıda karıştırılır.
  type Item = { id: string; t: string; u: string; c: string; col: string; i: string; dt: string; rm: number };
  const grid = document.getElementById('picks');
  if (grid) {
    const count = Number(grid.dataset.count) || 8;
    const exclude: string[] = JSON.parse(grid.dataset.exclude || '[]');
    const jsonUrl = grid.dataset.json || '/search.json';
    const rmText = grid.dataset.rm || 'dk okuma';

    const shuffle = <T,>(a: T[]) => {
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    const card = (it: Item) => {
      const a = document.createElement('a');
      a.className = 'story';
      a.href = it.u;
      a.style.setProperty('--c', it.col);
      const wrap = document.createElement('div');
      wrap.className = 'story-img';
      const img = document.createElement('img');
      img.src = it.i; img.alt = ''; img.width = 640; img.height = 400; img.loading = 'lazy'; img.decoding = 'async';
      wrap.appendChild(img);
      const body = document.createElement('div');
      body.className = 'story-body';
      const cat = document.createElement('span'); cat.className = 'cat'; cat.textContent = it.c;
      const h3 = document.createElement('h3'); h3.textContent = it.t;
      const meta = document.createElement('div'); meta.className = 'meta';
      const time = document.createElement('time'); time.textContent = it.dt;
      const rm = document.createElement('span'); rm.textContent = it.rm + ' ' + rmText;
      meta.append(time, rm);
      body.append(cat, h3, meta);
      a.append(wrap, body);
      return a;
    };

    fetch(jsonUrl)
      .then((r) => r.json())
      .then((all: Item[]) => {
        // Üstte zaten gösterilenleri çıkar; yeterli haber kalmazsa hepsinden seç
        const fresh = all.filter((it) => !exclude.includes(it.id));
        const pool = fresh.length >= count ? fresh : all;
        const picks = shuffle([...pool]).slice(0, count);
        if (!picks.length) return;
        grid.replaceChildren(...picks.map(card));
      })
      .catch(() => { /* hazır liste kalır */ });
  }
</script>
