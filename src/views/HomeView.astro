---
import Base from '../layouts/Base.astro';
import Slider from '../components/Slider.astro';
import NewsCard from '../components/NewsCard.astro';
import MostRead from '../components/MostRead.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import RandomPicks from '../components/RandomPicks.astro';
import { SITE } from '../consts';
import { getNews, getPopular, homeSets } from '../lib/news';
import Pager from '../components/Pager.astro';
import { langOf, T, ROUTES } from '../lib/i18n';

const lang = langOf(Astro.url);
const t = T[lang];
const r = ROUTES[lang];
const all = await getNews(lang);

// Manşet ve son haberler (lib/news.ts homeSets)
const { slides, feed } = homeSets(all);
const slideIds = new Set(slides.map((x) => x.id));
const feedIds = new Set(feed.map((h) => h.id));

const popular = getPopular(all, 10);
const PAGE_SIZE = 10;
const olderCount = all.filter((h) => !slideIds.has(h.id) && !feedIds.has(h.id)).length;
const totalPages = 1 + Math.ceil(olderCount / PAGE_SIZE);

// "Bunları da okuyun": sayfa HTML'inde hazır liste; tarayıcıda her yenilemede karıştırılır
const used = new Set([...slideIds, ...feedIds]);
const left = all.filter((h) => !used.has(h.id));
const picks = (left.length >= 8 ? left : all).slice(0, 8);

const origin = Astro.site!.href.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: origin + r.home,
  inLanguage: lang,
  description: lang === 'en' ? SITE.descriptionEn : SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}${r.search}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title={lang === 'en' ? 'Technology News, AI and Cybersecurity' : 'Teknoloji Haberleri, Yapay Zeka ve Siber Güvenlik'}
  jsonLd={jsonLd}
  alternates={{ tr: '/', en: '/en/' }}
>
  {
    all.length === 0 ? (
      <p class="empty">{t.empty}</p>
    ) : (
      <>
        <Slider items={slides} />
        <AdSlot pos="manset-alti" />

        <div class="cols">
          <section class="sec" style="margin-top:16px" aria-labelledby="son-haberler">
            <div class="sec-head">
              <h2 id="son-haberler">{t.latestNews}</h2>
            </div>
            <div class="grid2 grid2--home">
              {feed.map((h) => <NewsCard item={h} />)}
            </div>
            {lang === 'tr' && totalPages > 1 && <Pager current={1} total={totalPages} />}
          </section>

          <aside class="side" style="margin-top:56px" aria-label={t.sideAria}>
            <AdSlot pos="yan-ust" />
            <MostRead items={popular} />
          </aside>
        </div>

        <AdSlot pos="anasayfa-orta" />

        <Newsletter />

        <RandomPicks items={picks} excludeIds={[...used]} count={8} />
      </>
    )
  }
</Base>
