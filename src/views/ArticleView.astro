---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShareBar from '../components/ShareBar.astro';
import ShareDock from '../components/ShareDock.astro';
import ShareModal from '../components/ShareModal.astro';
import NewsCard from '../components/NewsCard.astro';
import MostRead from '../components/MostRead.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../consts';
import {
  absUrl, authorByName, authorUrl, catOf, catUrl, counterpart, fmtDate, getNews, getPopular, haberUrl, img,
  queueFor, readMins, tagSlug, tagUrl,
} from '../lib/news';
import { langOf, T, ROUTES } from '../lib/i18n';

const { entry } = Astro.props;
const lang = langOf(Astro.url);
const t = T[lang];
const r = ROUTES[lang];
const d = entry.data;
const c = catOf(d.category, lang);
const { Content, headings } = await render(entry);
const toc = headings.filter((h: { depth: number }) => h.depth === 2);
const author = authorByName(d.author, lang);

// Aynı haberin diğer dildeki karşılığı (varsa) hreflang ve dil değiştirici için kullanılır
const counter = await counterpart(entry, lang);
const alternates = counter ? { [lang === 'tr' ? 'en' : 'tr']: counter } : undefined;

const all = await getNews(lang);
const sameCat = all.filter((h) => h.id !== entry.id && h.data.category === d.category);
const others = all.filter((h) => h.id !== entry.id && h.data.category !== d.category);
const related = [...sameCat, ...others].slice(0, 3);
const popular = getPopular(all, 5, entry.id);
const queue = queueFor(all, entry, 12, lang);

const origin = Astro.site!.href.replace(/\/$/, '');
const path = haberUrl(entry.id, lang);
const url = origin + path;
const imgAbs = absUrl(d.image, Astro.site);
const docTitle = `${d.title} | ${SITE.name}`;
const authorLink = author ? origin + authorUrl(author.slug, lang) : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: d.title,
    description: d.description,
    image: [imgAbs],
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Person', name: d.author, ...(authorLink ? { url: authorLink } : {}) },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      logo: { '@type': 'ImageObject', url: absUrl(SITE.logo, Astro.site) },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    articleSection: c.name,
    keywords: d.tags.join(', '),
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.homeCrumb, item: origin + r.home },
      { '@type': 'ListItem', position: 2, name: c.name, item: `${origin}${catUrl(c.slug, lang)}` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base
  title={d.title}
  description={d.description}
  image={d.image}
  type="article"
  publishedTime={d.date}
  modifiedTime={d.updated ?? d.date}
  section={c.name}
  jsonLd={jsonLd}
  alternates={alternates}
  bottomNav={false}
>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <nav class="crumbs" aria-label={t.breadcrumb}>
    <a href={r.home}>{t.homeCrumb}</a> / <a href={catUrl(c.slug, lang)}>{c.name}</a>
  </nav>

  <div class="article-wrap">
    <ShareDock url={url} title={d.title} image={imgAbs} />

    <div class="article-col">
      <div id="stream" data-queue={JSON.stringify(queue)}>
        <article class="art" data-url={url} data-title={d.title} data-image={imgAbs} data-path={path} data-doctitle={docTitle}>
          <header class="article-head" style={`--c:${c.color}`}>
            <a class="chip" href={catUrl(c.slug, lang)}>{c.name}</a>
            <h1 class="article-title">{d.title}</h1>
            <p class="lead">{d.description}</p>
            <div class="byline">
              <span>{t.byAuthor}: {author ? <a href={authorUrl(author.slug, lang)}><strong>{d.author}</strong></a> : <strong>{d.author}</strong>}</span>
              <time datetime={d.date.toISOString()}>{fmtDate(d.date, lang)}</time>
              {d.updated && <span>{t.updated}: {fmtDate(d.updated, lang)}</span>}
              <span>{readMins(entry.body)} {t.readMin}</span>
            </div>
            <ShareBar url={url} title={d.title} image={imgAbs} />
          </header>

          <figure class="figure">
            <img src={img(d.image, 1200)} alt={d.imageAlt ?? d.title} width="1200" height="675" fetchpriority="high" decoding="async" />
            {d.imageCredit && <figcaption>{t.imageBy}: {d.imageCredit}</figcaption>}
          </figure>

          {
            d.summary.length > 0 && (
              <section class="tldr" aria-label={t.summary}>
                <h2>{t.summary}</h2>
                <ul>{d.summary.map((p: string) => <li>{p}</li>)}</ul>
              </section>
            )
          }
          {
            toc.length >= 3 && (
              <details class="toc">
                <summary>{t.toc}</summary>
                <ol>{toc.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
              </details>
            )
          }

          <div class="article-body">
            <Content />
          </div>
          <template class="ad-t" data-n="1"><AdSlot pos="haber-ici-1" /></template>
          <template class="ad-t" data-n="2"><AdSlot pos="haber-ici-2" /></template>

          <footer class="article-foot">
            {
              d.tags.length > 0 && (
                <div class="tags">
                  {d.tags.map((tg: string) => <a class="tag" href={tagUrl(tagSlug(tg), lang)}>#{tg}</a>)}
                </div>
              )
            }
            <ShareBar url={url} title={d.title} image={imgAbs} />
          </footer>

          {
            author && (
              <aside class="authorbox" aria-label={t.authorBox}>
                {author.photo ? <img src={author.photo} alt="" width="56" height="56" loading="lazy" /> : <span class="avatar" aria-hidden="true">{author.name.charAt(0)}</span>}
                <a href={authorUrl(author.slug, lang)}>
                  <strong>{author.name}</strong>
                  <small>{author.role}{author.role && author.bio ? ' · ' : ''}{author.bio}</small>
                </a>
              </aside>
            )
          }

          <AdSlot pos="haber-sonu" />
        </article>
      </div>

      <div id="stream-end" aria-hidden="true"></div>
      <div class="loadmore" id="loadmore" hidden>
        <button class="btn btn--ghost" id="loadmore-btn" type="button">{t.loadMore}</button>
      </div>
    </div>

    <aside class="side" aria-label={t.sideAria}>
      <AdSlot pos="yan-ust" />
      <MostRead items={popular} />
      <div class="stick"><AdSlot pos="yan-alt" /></div>
    </aside>
  </div>

  <section class="sec" aria-labelledby="ilgi">
    <div class="sec-head"><h2 id="ilgi">{t.related}</h2></div>
    <div class="grid3">
      {related.map((h) => <NewsCard item={h} excerpt={false} />)}
    </div>
  </section>

  <ShareModal />
</Base>

<script>
  import { shareHref } from '../lib/share';

  const stream = document.getElementById('stream');
  if (stream) {
    const w = window as any;
    const queue: string[] = JSON.parse(stream.dataset.queue || '[]');
    const end = document.getElementById('stream-end')!;
    const more = document.getElementById('loadmore')!;
    const moreBtn = document.getElementById('loadmore-btn')!;
    const bar = document.getElementById('progress')!;
    const dock = document.getElementById('dock');
    const BATCH = 3; // her seferde otomatik yüklenecek haber sayısı, sonra düğme çıkar

    let qi = 0;
    let budget = BATCH;
    let loading = false;
    document.body.classList.add('has-dock');

    const arts = () => Array.from(stream.querySelectorAll<HTMLElement>('article.art'));
    const ctxOf = (a: HTMLElement) => ({ url: a.dataset.url!, title: a.dataset.title!, image: a.dataset.image ?? '' });
    let current = arts()[0];
    w.__dhCtx = ctxOf(current);

    // Reklam alanları: 2. paragraftan sonra ve uzun haberlerde 6. paragraftan sonra
    const pushAds = (root: ParentNode) => {
      if (!w.__dhAdsOn) return;
      root.querySelectorAll('ins.adsbygoogle:not([data-pushed])').forEach((el) => {
        el.setAttribute('data-pushed', '1');
        (w.adsbygoogle = w.adsbygoogle || []).push({});
      });
    };
    const prepare = (a: HTMLElement) => {
      const paras = a.querySelectorAll('.article-body > p');
      a.querySelectorAll<HTMLTemplateElement>('template.ad-t').forEach((t) => {
        if (!t.content.childElementCount) return;
        const first = t.dataset.n === '1';
        const at = first ? 1 : 5;
        const min = first ? 4 : 9;
        if (paras.length >= min && paras[at]) paras[at].after(t.content.cloneNode(true));
      });
      pushAds(a);
    };
    prepare(current);

    // Hangi haber ekrandaysa adres, başlık ve paylaşım ona geçer
    const setCurrent = (a: HTMLElement) => {
      current = a;
      w.__dhCtx = ctxOf(a);
      if (a.dataset.path) history.replaceState(null, '', a.dataset.path);
      if (a.dataset.doctitle) document.title = a.dataset.doctitle;
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const line = window.innerHeight * 0.35;
        let cur = arts()[0];
        for (const a of arts()) if (a.getBoundingClientRect().top <= line) cur = a;
        if (cur !== current) setCurrent(cur);
        const r = cur.getBoundingClientRect();
        const total = r.height - window.innerHeight * 0.6;
        const done = Math.min(Math.max(-r.top, 0), Math.max(total, 1));
        bar.style.transform = `scaleX(${total > 0 ? done / total : 0})`;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // Yan çubuktaki paylaşım düğmeleri (o an ekrandaki haberi paylaşır)
    dock?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-net]');
      if (!b) return;
      window.open(shareHref(b.dataset.net!, w.__dhCtx), '_blank', 'noopener');
    });

    // Sonraki haberi getir ve altına ekle
    const loadNext = async () => {
      if (loading || qi >= queue.length) return;
      loading = true;
      const href = queue[qi++];
      try {
        const res = await fetch(href);
        if (!res.ok) throw new Error('yüklenemedi');
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const art = doc.querySelector<HTMLElement>('article.art');
        if (art) {
          const node = document.importNode(art, true) as HTMLElement;
          const h1 = node.querySelector('h1');
          if (h1) {
            const h2 = document.createElement('h2');
            h2.className = h1.className;
            h2.innerHTML = h1.innerHTML;
            h1.replaceWith(h2);
          }
          stream.appendChild(node);
          prepare(node);
          onScroll();
        }
      } catch {
        /* bu haber atlanır, sıradakine geçilir */
      } finally {
        loading = false;
      }
    };

    const io = new IntersectionObserver(
      async (entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        if (budget <= 0 || qi >= queue.length) return;
        budget--;
        await loadNext();
        if (budget <= 0 && qi < queue.length) more.hidden = false;
        // Eklenen haber kısaysa ayraç hâlâ görünür olabilir: yeniden değerlendir
        io.unobserve(end);
        io.observe(end);
      },
      { rootMargin: '700px 0px' }
    );
    io.observe(end);

    moreBtn.addEventListener('click', () => {
      budget = BATCH;
      more.hidden = true;
      io.unobserve(end);
      io.observe(end);
    });
  }
</script>
