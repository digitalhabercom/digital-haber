---
interface Props {
  url: string;
  title: string;
  image?: string;
}
const { url, title, image = '' } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const m = encodeURIComponent(image);

const targets = [
  { name: 'Pinterest', bc: '#e60023', ico: 'P', href: `https://pinterest.com/pin/create/button/?url=${u}&media=${m}&description=${t}` },
  { name: 'Facebook', bc: '#1877f2', ico: 'f', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { name: 'X (Twitter)', bc: '#111111', ico: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
  { name: 'WhatsApp', bc: '#1fa855', ico: 'W', href: `https://wa.me/?text=${t}%20${u}` },
  { name: 'Telegram', bc: '#229ed9', ico: 'T', href: `https://t.me/share/url?url=${u}&text=${t}` },
  { name: 'Messenger', bc: '#0a7cff', ico: 'M', href: `fb-messenger://share/?link=${u}` },
  { name: 'Reddit', bc: '#ff4500', ico: 'R', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { name: 'LinkedIn', bc: '#0a66c2', ico: 'in', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
];
const mail = `mailto:?subject=${t}&body=${u}`;
---

<dialog class="share" id="share-dialog" aria-labelledby="share-title">
  <div class="share-in">
    <div class="share-head">
      <h2 id="share-title">Bu haberi paylaş</h2>
      <p>{title}</p>
      <button class="share-close" type="button" data-share-close aria-label="Kapat">✕</button>
    </div>

    <div class="share-grid">
      {
        targets.map((s) => (
          <a class="share-btn" style={`--bc:${s.bc}`} href={s.href} target="_blank" rel="noopener noreferrer">
            <i>{s.ico}</i>
            {s.name}
          </a>
        ))
      }
      <button class="share-btn wide" id="share-native" style="--bc:#2a3df5" type="button" hidden>
        <i>↗</i> Telefonundaki uygulamalarla paylaş
      </button>
      <a class="share-btn wide" style="--bc:#6b7280" href={mail}><i>@</i> E-Posta</a>
    </div>

    <div class="share-or">veya bağlantıyı kopyala</div>
    <div class="share-copy">
      <input type="text" readonly value={url} id="share-url" aria-label="Haber bağlantısı" />
      <button type="button" id="share-copy" data-share-copy>Kopyala</button>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('share-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('share-url') as HTMLInputElement | null;
  const native = document.getElementById('share-native') as HTMLButtonElement | null;

  document.querySelectorAll('[data-share-open]').forEach((b) => b.addEventListener('click', () => dlg?.showModal()));
  dlg?.querySelector('[data-share-close]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  const copy = async (btn: HTMLElement) => {
    if (!input) return;
    try {
      await navigator.clipboard.writeText(input.value);
    } catch {
      input.select();
      document.execCommand('copy');
    }
    const old = btn.textContent;
    btn.textContent = 'Kopyalandı ✓';
    window.setTimeout(() => (btn.textContent = old), 1800);
  };
  document.querySelectorAll<HTMLElement>('[data-share-copy], [data-copy-link]').forEach((b) => b.addEventListener('click', () => copy(b)));

  if (native && typeof navigator.share === 'function' && input) {
    native.hidden = false;
    native.addEventListener('click', () => {
      navigator.share({ title: document.title, url: input.value }).catch(() => {});
    });
  }
</script>
