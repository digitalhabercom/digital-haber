---
import Base from '../layouts/Base.astro';
import Slider from '../components/Slider.astro';
import NewsCard from '../components/NewsCard.astro';
import MostRead from '../components/MostRead.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../consts';
import { CATEGORIES, getNews, getPopular } from '../lib/news';

const all = await getNews();

// Manşet: "featured" işaretliler önce, eksik kalırsa en yeniler ile 6'ya tamamlanır
const slides = [...all.filter((h) => h.data.featured), ...all.filter((h) => !h.data.featured)].slice(0, 6);
const slideIds = new Set(slides.map((s) => s.id));

// Son haberler: manşette olmayanlar; yetmezse tüm haberler
const rest = all.filter((h) => !slideIds.has(h.id));
const feedSource = rest.length >= 3 ? rest : all;
const lead = feedSource[0];
const feed = feedSource.slice(1, 7);

const popular = getPopular(all, 5);

// Kategori blokları: en az 2 haberi olan ilk 3 kategori
const blocks = CATEGORIES.map((c) => ({ c, items: all.filter((h) => h.data.category === c.slug).slice(0, 4) }))
  .filter((b) => b.items.length >= 2)
  .slice(0, 3);

const origin = Astro.site!.href.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: origin + '/',
  inLanguage: 'tr',
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}/arama/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title="Teknoloji Haberleri, Yapay Zeka ve Siber Güvenlik" jsonLd={jsonLd}>
  {
    all.length === 0 ? (
      <p class="empty">Henüz haber yok. /admin adresinden ilk haberi ekleyin.</p>
    ) : (
      <>
        <Slider items={slides} />
        <AdSlot size="leaderboard" />

        <div class="cols">
          <section class="sec" style="margin-top:16px" aria-labelledby="son-haberler">
            <div class="sec-head">
              <h2 id="son-haberler">Son Haberler</h2>
              <a href="/haberler/">Tüm haberler</a>
            </div>
            <div class="grid2">
              <NewsCard item={lead} variant="lead" />
              {feed.map((h) => <NewsCard item={h} />)}
            </div>
          </section>

          <aside class="side" style="margin-top:56px" aria-label="Yan sütun">
            <AdSlot size="rectangle" />
            <MostRead items={popular} />
            <AdSlot size="tall" />
          </aside>
        </div>

        {
          blocks.map((b, i) => (
            <>
              <section class="sec" aria-labelledby={`blok-${b.c.slug}`}>
                <div class="sec-head">
                  <h2 id={`blok-${b.c.slug}`}>{b.c.name}</h2>
                  <a href={`/kategori/${b.c.slug}/`}>Tümü</a>
                </div>
                <div class="grid4">
                  {b.items.map((h) => <NewsCard item={h} excerpt={false} />)}
                </div>
              </section>
              {i === 0 && <AdSlot size="leaderboard" />}
            </>
          ))
        }
      </>
    )
  }
</Base>
