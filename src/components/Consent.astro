---
import ads from '../data/reklam.json';
import { langOf, T, ROUTES } from '../lib/i18n';
const client = ((ads as any).adsenseClient ?? '') as string;
const lang = langOf(Astro.url);
const t = T[lang];
---

{
  client && (
    <div id="consent" class="consent" role="dialog" aria-label={t.consentAria} data-client={client} hidden>
      <p>
        {t.consentText}{' '}
        <a href={ROUTES[lang].privacy}>{t.consentLink}</a> {t.consentEnd}
      </p>
      <div class="consent-btns">
        <button id="consent-no" type="button">{t.reject}</button>
        <button id="consent-yes" type="button">{t.accept}</button>
      </div>
    </div>
  )
}

<script>
  const box = document.getElementById('consent');
  if (box) {
    const client = box.dataset.client ?? '';
    const KEY = 'dh-consent';
    const get = () => {
      try { return localStorage.getItem(KEY); } catch { return null; }
    };
    const set = (v: string) => {
      try { localStorage.setItem(KEY, v); } catch { /* yok say */ }
    };
    const loadAds = () => {
      const w = window as any;
      w.__dhAdsOn = true;
      const s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
      document.head.appendChild(s);
      w.adsbygoogle = w.adsbygoogle || [];
      document.querySelectorAll('ins.adsbygoogle:not([data-pushed])').forEach((el) => {
        el.setAttribute('data-pushed', '1');
        w.adsbygoogle.push({});
      });
    };
    const saved = get();
    if (saved === 'yes') loadAds();
    else if (!saved) box.hidden = false;
    document.getElementById('consent-yes')?.addEventListener('click', () => { set('yes'); box.hidden = true; loadAds(); });
    document.getElementById('consent-no')?.addEventListener('click', () => { set('no'); box.hidden = true; });
  }
</script>
