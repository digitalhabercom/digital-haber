---
import AuthorView from '../../../views/AuthorView.astro';
import { authorsFor } from '../../../lib/news';

export function getStaticPaths() {
  return authorsFor('en').map((a) => ({ params: { slug: a.slug }, props: { slug: a.slug } }));
}
const { slug } = Astro.props;
---

<AuthorView slug={slug} />
