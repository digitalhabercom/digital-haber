---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import MostRead from '../../components/MostRead.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES, getNews, getPopular } from '../../lib/news';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const all = await getNews();
const items = all.filter((h) => h.data.category === cat.slug);
const popular = getPopular(all, 5);
const origin = Astro.site!.href.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: origin + '/' },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${origin}/kategori/${cat.slug}/` },
  ],
};
---

<Base title={`${cat.name} Haberleri`} description={cat.desc} jsonLd={jsonLd}>
  <div class="page-head">
    <h1>{cat.name}</h1>
    <p>{cat.desc}</p>
  </div>

  <div class="cols" style="margin-top:28px">
    <section aria-label={`${cat.name} haberleri`}>
      {
        items.length ? (
          <div class="grid2">
            {items.map((h, i) => <NewsCard item={h} variant={i === 0 ? 'lead' : 'card'} />)}
          </div>
        ) : (
          <p class="empty">Bu kategoride henüz haber yok.</p>
        )
      }
    </section>
    <aside class="side" aria-label="Yan sütun">
      <AdSlot size="rectangle" />
      <MostRead items={popular} />
    </aside>
  </div>
</Base>
