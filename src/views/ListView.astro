---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import MostRead from '../components/MostRead.astro';
import AdSlot from '../components/AdSlot.astro';
import { getNews, getPopular } from '../lib/news';
import { langOf, T } from '../lib/i18n';

interface Props {
  page: any;
}
const { page } = Astro.props;
const lang = langOf(Astro.url);
const t = T[lang];
const all = await getNews(lang);
const popular = getPopular(all, 10);
const title = page.currentPage > 1 ? `${t.allNews}, ${page.currentPage}` : t.allNews;
const desc =
  lang === 'en'
    ? 'All technology news on digitalhaber, newest first.'
    : 'digitalhaber üzerindeki tüm teknoloji haberleri, yeniden eskiye sıralı.';
---

<Base title={title} description={desc} alternates={{ tr: '/haberler/', en: '/en/latest/' }}>
  <div class="page-head">
    <h1>{t.allNews}</h1>
    <p>{page.total} {t.nNews}, {t.sortedNote}</p>
  </div>

  <div class="cols" style="margin-top:28px">
    <section aria-label={t.newsList}>
      <div class="grid2">
        {page.data.map((h: any) => <NewsCard item={h} />)}
      </div>
      <nav class="pager" aria-label={t.pagination}>
        {page.url.prev ? <a class="btn btn--ghost" href={page.url.prev}>{t.newer}</a> : <span />}
        {page.url.next ? <a class="btn" href={page.url.next}>{t.older}</a> : <span />}
      </nav>
    </section>
    <aside class="side" aria-label={t.sideAria}>
      <AdSlot pos="yan-ust" />
      <MostRead items={popular} />
      <div class="stick"><AdSlot pos="yan-alt" /></div>
    </aside>
  </div>
</Base>
