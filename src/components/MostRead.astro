---
import { catOf, haberUrl, type Haber } from '../lib/news';

interface Props {
  items: Haber[];
}
const { items } = Astro.props;
---

<section aria-labelledby="mostread-title">
  <div class="sec-head"><h2 id="mostread-title">En Çok Okunanlar</h2></div>
  <ol class="mostread">
    {
      items.map((h) => (
        <li>
          <div>
            <span class="cat" style={`--c:${catOf(h.data.category).color}`}>{catOf(h.data.category).name}</span>
            <a href={haberUrl(h.id)}>{h.data.title}</a>
          </div>
        </li>
      ))
    }
  </ol>
</section>
