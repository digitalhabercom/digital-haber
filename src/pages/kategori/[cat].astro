---
import CategoryView from '../../views/CategoryView.astro';
import { CATEGORIES, getNews } from '../../lib/news';

// Yalnızca haberi olan kategoriler için sayfa üretilir (boş sayfa Google'da değersiz görünür)
export async function getStaticPaths() {
  const all = await getNews('tr');
  return CATEGORIES.filter((c) => all.some((h) => h.data.category === c.slug)).map((c) => ({
    params: { cat: c.slug },
    props: { slug: c.slug },
  }));
}
const { slug } = Astro.props;
---

<CategoryView slug={slug} />
