---
import { langOf, T } from '../lib/i18n';
interface Props { id: string }
const { id } = Astro.props;
const t = T[langOf(Astro.url)];
---

<button class="sb sb--plain sb--save" type="button" data-save={id} data-l-save={t.save} data-l-saved={t.saved} aria-pressed="false">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"></path></svg>
  <span>{t.save}</span>
</button>
