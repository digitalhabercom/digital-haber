---
import Icon from './Icon.astro';
import { shareHref } from '../lib/share';
import { langOf, T } from '../lib/i18n';

interface Props {
  url: string;
  title: string;
  image?: string;
  id?: string;
}
const { url, title, image = '' } = Astro.props;
const ctx = { url, title, image };
const t = T[langOf(Astro.url)];

// Doğrudan paylaşım bağlantıları (mesajlaşma uygulamaları önce)
const nets = [
  { net: 'whatsapp', name: 'WhatsApp', bc: '#1fa855' },
  { net: 'telegram', name: 'Telegram', bc: '#229ed9' },
  { net: 'facebook', name: 'Facebook', bc: '#1877f2' },
  { net: 'x', name: 'X', bc: '#111111' },
  { net: 'linkedin', name: 'LinkedIn', bc: '#0a66c2' },
  { net: 'reddit', name: 'Reddit', bc: '#ff4500' },
  { net: 'threads', name: 'Threads', bc: '#000000' },
];
---

<div class="sharebar" role="group" aria-label={t.shareNews}>
  <span class="sharebar-label">{t.share}</span>
  <div class="sharebar-row">
    {
      nets.map((n) => (
        <a
          class:list={['sb-ico', { 'only-touch': n.touch }]}
          style={`--bc:${n.bc}`}
          href={shareHref(n.net, ctx)}
          target={n.touch ? undefined : '_blank'}
          rel="noopener noreferrer"
          aria-label={`${n.name} ${t.share}`}
          title={n.name}
        >
          <Icon name={n.net} size={n.net === 'reddit' ? 24 : n.net === 'whatsapp' ? 22 : 18} />
        </a>
      ))
    }
    <button class="sb-ico sb-ico--copy" type="button" data-copy-link data-url={url} aria-label={t.copyLink} title={t.copyLink}>
      <Icon name="link" size={18} />
    </button>
  </div>
</div>
