---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import MostRead from '../../components/MostRead.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES, getNews, getPopular } from '../../lib/news';

// Yalnızca haberi olan kategoriler için sayfa üretilir (boş sayfa Google'da değersiz görünür)
export async function getStaticPaths() {
  const all = await getNews();
  return CATEGORIES.filter((c) => all.some((h) => h.data.category === c.slug)).map((c) => ({
    params: { cat: c.slug },
    props: { cat: c },
  }));
}

const { cat } = Astro.props;
const all = await getNews();
const items = all.filter((h) => h.data.category === cat.slug);
const popular = getPopular(all, 5);
const origin = Astro.site!.href.replace(/\/$/, '');
const desc = cat.desc || `${cat.name} alanındaki en güncel teknoloji haberleri ve rehberler.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: origin + '/' },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${origin}/kategori/${cat.slug}/` },
  ],
};
---

<Base title={`${cat.name} Haberleri`} description={desc} jsonLd={jsonLd}>
  <div class="page-head">
    <h1>{cat.name}</h1>
    <p>{desc}</p>
  </div>

  <div class="cols" style="margin-top:28px">
    <section aria-label={`${cat.name} haberleri`}>
      <div class="grid2">
        {items.map((h) => <NewsCard item={h} />)}
      </div>
    </section>
    <aside class="side" aria-label="Yan sütun">
      <AdSlot pos="yan-ust" />
      <MostRead items={popular} />
      <div class="stick"><AdSlot pos="yan-alt" /></div>
    </aside>
  </div>
</Base>
