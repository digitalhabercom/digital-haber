---
import Icon from './Icon.astro';
import { langOf, T } from '../lib/i18n';
const t = T[langOf(Astro.url)];

const nets = [
  { net: 'pinterest', name: 'Pinterest', bc: '#e60023' },
  { net: 'facebook', name: 'Facebook', bc: '#1877f2' },
  { net: 'x', name: 'X (Twitter)', bc: '#111111' },
  { net: 'whatsapp', name: 'WhatsApp', bc: '#1fa855' },
  { net: 'telegram', name: 'Telegram', bc: '#229ed9' },
  { net: 'reddit', name: 'Reddit', bc: '#ff4500' },
  { net: 'linkedin', name: 'LinkedIn', bc: '#0a66c2' },
];
---

<dialog class="share" id="share-dialog" aria-labelledby="share-title">
  <div class="share-in">
    <div class="share-head">
      <h2 id="share-title">{t.shareTitle}</h2>
      <p id="share-name"></p>
      <button class="share-close" type="button" data-share-close aria-label={t.close}>✕</button>
    </div>

    <div class="share-grid">
      {
        nets.map((n) => (
          <a class="share-btn" style={`--bc:${n.bc}`} data-net={n.net} href="#" target="_blank" rel="noopener noreferrer">
            <i><Icon name={n.net} size={14} /></i>
            {n.name}
          </a>
        ))
      }
      <a class="share-btn only-mouse" style="--bc:#d93025" data-net="gmail" href="#" target="_blank" rel="noopener noreferrer">
        <i><Icon name="mail" size={14} /></i> Gmail
      </a>
      <button class="share-btn wide" id="share-native" style="--bc:#1256f0" type="button" hidden>
        <i><Icon name="share" size={14} /></i> {t.shareNative}
      </button>
      <a class="share-btn wide" style="--bc:#6b7280" data-net="mail" href="#">
        <i><Icon name="mail" size={14} /></i> {t.shareMail}
      </a>
    </div>

    <div class="share-or">{t.shareOr}</div>
    <div class="share-copy">
      <input type="text" readonly value="" id="share-url" aria-label={t.urlLabel} />
      <button type="button" id="share-copy" data-done={t.copied}>{t.copy}</button>
    </div>
  </div>
</dialog>

<script>
  import { shareHref, type Ctx } from '../lib/share';

  const dlg = document.getElementById('share-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('share-url') as HTMLInputElement | null;
  const nameEl = document.getElementById('share-name');
  const native = document.getElementById('share-native') as HTMLButtonElement | null;
  let ctx: Ctx | null = null;

  const flash = (btn: HTMLElement, text: string) => {
    const old = btn.innerHTML;
    btn.innerHTML = text;
    window.setTimeout(() => (btn.innerHTML = old), 1600);
  };
  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
  };

  const open = (c: Ctx) => {
    if (!dlg || !input) return;
    ctx = c;
    input.value = c.url;
    if (nameEl) nameEl.textContent = c.title;
    dlg.querySelectorAll<HTMLAnchorElement>('a[data-net]').forEach((a) => {
      a.href = shareHref(a.dataset.net!, c);
    });
    dlg.showModal();
  };

  // Tek bir dinleyici: sonradan eklenen haberlerdeki butonlar da çalışır
  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;

    const opener = el.closest<HTMLElement>('[data-share-open]');
    if (opener) {
      const w = window as any;
      const c: Ctx | undefined = opener.dataset.url
        ? { url: opener.dataset.url, title: opener.dataset.title ?? '', image: opener.dataset.image ?? '' }
        : w.__dhCtx;
      if (c) open(c);
      return;
    }

    const cp = el.closest<HTMLElement>('[data-copy-link]');
    if (cp) {
      const w = window as any;
      const url = cp.dataset.url ?? w.__dhCtx?.url ?? location.href;
      copyText(url).then(() => flash(cp, '✓'));
    }
  });

  dlg?.querySelector('[data-share-close]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.getElementById('share-copy')?.addEventListener('click', (e) => {
    if (input) copyText(input.value).then(() => flash(e.currentTarget as HTMLElement, (e.currentTarget as HTMLElement).dataset.done || '✓'));
  });

  if (native && typeof navigator.share === 'function') {
    native.hidden = false;
    native.addEventListener('click', () => {
      if (ctx) navigator.share({ title: ctx.title, url: ctx.url }).catch(() => {});
    });
  }
</script>
