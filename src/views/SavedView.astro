---
import Base from '../layouts/Base.astro';
import { langOf, T, ROUTES } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = T[lang];
const r = ROUTES[lang];
---

<Base title={t.savedTitle} description={t.savedTitle} noindex={true} ads={false} alternates={{ tr: '/kaydedilenler/', en: '/en/saved/' }}>
  <div class="page-head"><h1>{t.savedTitle}</h1></div>
  <p class="result-count" id="saved-empty" hidden>{t.savedEmpty}</p>
  <div class="results" id="saved-list" data-json={r.searchJson}></div>
</Base>

<script>
  type Item = { id: string; t: string; d: string; u: string; c: string; i: string };
  const list = document.getElementById('saved-list')!;
  const empty = document.getElementById('saved-empty')!;
  let ids: string[] = [];
  try { ids = JSON.parse(localStorage.getItem('dh-saved') || '[]'); } catch { ids = []; }
  (async () => {
    if (!ids.length) { empty.hidden = false; return; }
    const data: Item[] = await (await fetch(list.dataset.json || '/search.json')).json();
    const hits = ids.map((id) => data.find((x) => x.id === id)).filter(Boolean) as Item[];
    if (!hits.length) { empty.hidden = false; return; }
    for (const it of hits) {
      const a = document.createElement('a');
      a.className = 'story-row story-row--big';
      a.href = it.u;
      const wrap = document.createElement('div'); wrap.className = 'story-img';
      const im = document.createElement('img'); im.src = it.i; im.alt = ''; im.loading = 'lazy'; im.width = 200; im.height = 125;
      wrap.appendChild(im);
      const body = document.createElement('div');
      const cat = document.createElement('span'); cat.className = 'cat'; cat.textContent = it.c;
      const h3 = document.createElement('h3'); h3.textContent = it.t;
      const p = document.createElement('p'); p.textContent = it.d;
      body.append(cat, h3, p);
      a.append(wrap, body);
      list.appendChild(a);
    }
  })();
</script>
